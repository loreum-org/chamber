# Dedicated HTTPS RPC URLs. Set one for each chain this process indexes.
# A chain with no Factory in contracts/deployments/<network>.txt is skipped, so
# its URL can be set before that deploy. Do not use an origin-locked frontend key.
PONDER_RPC_URL_84532=
PONDER_RPC_URL_421614=
PONDER_RPC_URL_11155420=
# Ethereum Sepolia. Unused until sepolia.txt records a 1.3.0 Factory
# (the Aug 26, 2026 Factory is ignored).
PONDER_RPC_URL_11155111=

# Postgres connection string for `ponder start` in production.
# `ponder dev` uses the local PGlite database when this is unset.
DATABASE_URL=
# Schema name required by `ponder start` (Ponder 0.8). Example: public
DATABASE_SCHEMA=

# Optional per-chain overrides. Unset values come from
# contracts/deployments/<network>.txt. Suffix is the chain id.
# PONDER_FACTORY_ADDRESS_84532=
# PONDER_FACTORY_START_BLOCK_84532=
# Leave Registry unset on a chain that has none. The indexer uses
# 0x000000000000000000000000000000000000dEaD so those handlers stay registered.
# PONDER_REGISTRY_ADDRESS_84532=
# PONDER_REGISTRY_START_BLOCK_84532=
# Repeat the suffix for 421614, 11155420, and 11155111.
