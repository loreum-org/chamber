# Explorers app environment
# Copy to .env and fill in values for local development.
# Production (Railway) env vars are set in the dashboard — NOT in this file.
#
# Chain defaults: Mainnet is the default chain in production.
# Sepolia is available for testing (switch via the network selector in the UI).

# ── Required in production ──────────────────────────────────────────

# WalletConnect project ID (required for wallet connections)
# Get a free ID at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# ── RPC URLs (optional — falls back to public RPCs) ─────────────────

# Ethereum Mainnet RPC URL
# Production should use a dedicated Alchemy/Infura/QuickNode endpoint.
VITE_MAINNET_RPC_URL=

# Sepolia testnet RPC URL
VITE_SEPOLIA_RPC_URL=

# ── Contract addresses (optional — defaults from deployments register) ─

# LoreumNFT on Ethereum mainnet
VITE_LOREUM_NFT_MAINNET=0xB99DEdbDe082B8Be86f06449f2fC7b9FED044E15

# LoreumNFT on Sepolia testnet
VITE_LOREUM_NFT_SEPOLIA=0x69e41faF363A6Be4Cde76268315F48Ef0034C8b8
