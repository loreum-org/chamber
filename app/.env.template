# Optional Ponder GraphQL host (indexer/ package in this repo).
# One URL covers every chain in VITE_INDEXER_CHAIN_IDS. Leave unset to use
# chunked Factory/Registry getLogs on every chain.
# VITE_INDEXER_URL=https://your-ponder-host.example
# Comma-separated chain ids this indexer serves. The app only queries ids in
# SUPPORTED_WALLET_CHAIN_IDS (Ethereum mainnet 1 and Sepolia 11155111).
# 84532 may still be indexed on the host; My chambers ignores it.
# VITE_INDEXER_CHAIN_IDS=1,11155111
# Single-chain fallback used when VITE_INDEXER_CHAIN_IDS is unset.
# VITE_INDEXER_CHAIN_ID=1

# Discovery start blocks.
# Base Sepolia Factory 0x9bd245B992f0ba869D208bdABecB608080984701 was deployed at 48743114.
# VITE_BASE_SEPOLIA_FACTORY_START_BLOCK=48743114
# VITE_BASE_SEPOLIA_FACTORY=
# VITE_BASE_SEPOLIA_CHAMBER_IMPL=
# Arbitrum Sepolia (421614) and OP Sepolia (11155420) read
# contracts/deployments/arbitrum-sepolia.txt and op-sepolia.txt (make deploy-testnet).
# VITE_ARBITRUM_SEPOLIA_FACTORY=
# VITE_ARBITRUM_SEPOLIA_FACTORY_START_BLOCK=
# VITE_OP_SEPOLIA_FACTORY=
# VITE_OP_SEPOLIA_FACTORY_START_BLOCK=
# Ethereum Sepolia defaults stay in contracts/deployments/sepolia.txt (chain 11155111).
# Nov 10, 2026 Factory 0xE87FF28C44593122e4BD87e48A18c9f08eBc811d, start block 12099299.
# Discovery still starts at the older Factory block so Aug 26 chambers stay visible.
# VITE_SEPOLIA_FACTORY_START_BLOCK=11571185
# VITE_SEPOLIA_REGISTRY_START_BLOCK=7453704

# Throwaway Sepolia key for `npm run test:e2e:sepolia` (never commit). Needs Sepolia ETH.
# E2E_SEPOLIA_PRIVATE_KEY=
# SEPOLIA_PRIVATE_KEY=
# PLAYWRIGHT_BASE_URL=https://app.loreum.org
# PLAYWRIGHT_SEPOLIA_CHAMBER=

# Ethereum mainnet Factory / Chamber implementation are in
# contracts/deployments/mainnet.txt (Nov 10, 2026).
# Factory 0x35977d540799db1e8910c00F476a879E2c0e1a24, start block 26379502.
# VITE_MAINNET_FACTORY=
# VITE_MAINNET_CHAMBER_IMPL=
# VITE_MAINNET_FACTORY_START_BLOCK=26379502
# VITE_MAINNET_REGISTRY=

# WalletConnect Cloud project ID (free at https://cloud.walletconnect.com).
# Required in production; in dev the app crashes at startup without it
# (RainbowKit throws even though wagmi only warns).
# VITE_WALLETCONNECT_PROJECT_ID=